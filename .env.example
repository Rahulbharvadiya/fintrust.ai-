# ==============================================================================
# fintrust.ai & Hackathon OS v2.0 - Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Security & Multi-tier JWT Configuration
JWT_SECRET=super_secure_jwt_secret_token_change_in_production_2026
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL Database Integration
# (Leave empty for ultra-fast local in-memory execution; populate to connect to cloud Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Vision AI Cloud Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
GEMINI_API_KEY=

# Event Countdown Deadline (Epoch Timestamp in Milliseconds)
SUBMISSION_DEADLINE_MS=

# CORS Configuration
CORS_ORIGIN=*
